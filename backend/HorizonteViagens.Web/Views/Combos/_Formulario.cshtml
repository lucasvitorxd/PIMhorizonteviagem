@model HorizonteViagens.Modelos.Dtos.ComboSalvarDto
@* PARTIAL VIEW com os campos do combo, compartilhada por Criar e Editar.
   Fica só o conteúdo; a tag <form> está em cada tela. *@

<div asp-validation-summary="All" class="text-danger" role="alert"></div>

@* Versao: número que muda a cada gravação. Se outra pessoa salvou antes,
   o número não bate e o sistema avisa em vez de apagar a alteração dela. *@
<input asp-for="Versao" type="hidden">

@* form-grid: duas colunas no computador e uma no celular (horizonte.css). *@
<div class="form-grid">
    <label>Nome <input asp-for="Nome" class="form-control" required maxlength="100"></label>
    <label>Destino <input asp-for="Destino" class="form-control" required maxlength="100"></label>
    <label>Origem <input asp-for="Origem" class="form-control" required maxlength="100"></label>
    <label>Categoria
        <select asp-for="Categoria" class="form-select">
            <option>Luxo</option>
            <option>Econômico</option>
        </select>
    </label>
    <label>Evento <input asp-for="Evento" class="form-control" maxlength="140"></label>
    <label>Partida <input asp-for="Partida" type="date" class="form-control"></label>
    <label>Noites <input asp-for="Noites" type="number" min="1" max="60" class="form-control"></label>
    <label>Vagas para adultos <input asp-for="Vagas" type="number" min="0" class="form-control"></label>

    @* Os três valores que a Precificacao usa para montar o total do grupo.
       inputmode="decimal" abre o teclado numérico com vírgula no celular. *@
    <label>Transporte/serviços por adulto (R$) <input asp-for="Valor" type="text" asp-format="{0:0.00}" class="form-control" inputmode="decimal" placeholder="0,00"></label>
    <label>Diária por quarto de até 2 adultos (R$) <input asp-for="DiariaQuarto" type="text" asp-format="{0:0.00}" class="form-control" inputmode="decimal" placeholder="0,00"></label>
    <label>Experiências por adulto (R$) <input asp-for="ValorExperiencias" type="text" asp-format="{0:0.00}" class="form-control" inputmode="decimal" placeholder="0,00"></label>

    <label>Imagem
        <select asp-for="Imagem" class="form-select">
            @foreach (var imagem in new[] { "paris", "tokyo", "newyork", "beach", "coast", "hero" })
            {
                <option>@imagem</option>
            }
        </select>
    </label>
</div>

<label class="d-block">Descrição
    <textarea asp-for="Descricao" class="form-control" maxlength="2000"></textarea>
</label>
<label class="d-block">Inclusões (uma por linha)
    <textarea asp-for="Inclusoes" rows="4" class="form-control" maxlength="2000"></textarea>
</label>

@* Publicado: aparece na vitrine. PrecoConfirmado: libera o botão de reservar. *@
<label class="d-block my-3"><input asp-for="Publicado"> Publicar na vitrine</label>
<label class="d-block my-3"><input asp-for="PrecoConfirmado"> Preço e serviços confirmados com os fornecedores</label>
<p class="price-note">
    Só marque a confirmação quando a oferta tiver data futura e condições válidas.
    Esta confirmação libera a reserva das vagas cadastradas.
</p>

<button class="btn btn-gold" type="submit">Salvar combo</button>
<a asp-action="Gerenciar" class="btn btn-outline-dark">Cancelar</a>
