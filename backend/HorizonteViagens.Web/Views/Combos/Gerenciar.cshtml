@model List<HorizonteViagens.Modelos.Dtos.ComboDto>
@* GERENCIAR COMBOS (só administrador): lista todos os combos, inclusive os
   não publicados, com os links de editar e excluir. *@
@{
    ViewData["Title"] = "Gerenciar combos";
}

<section class="container section">
    <div class="section-title">
        <h1>Gerenciar combos</h1>
        <a class="btn btn-gold" asp-action="Criar">+ Novo combo</a>
    </div>

    @* table-responsive: no celular a tabela rola para o lado dentro da caixa,
       em vez de alargar a página inteira. *@
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Destino / evento</th>
                    <th>Vagas</th>
                    <th>Partida</th>
                    <th>Publicado</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var combo in Model)
                {
                    <tr>
                        <td><strong>@combo.Nome</strong><br>@combo.Evento</td>
                        <td>@combo.Vagas</td>
                        <td>@(combo.Partida?.ToString("dd/MM/yyyy") ?? "Sob consulta")</td>
                        <td>@(combo.Publicado ? "Sim" : "Não")</td>
                        <td>
                            <a asp-action="Editar" asp-route-id="@combo.Id">Editar</a> ·
                            <a asp-action="Excluir" asp-route-id="@combo.Id">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
