@* LAYOUT: a "moldura" de todas as páginas do site.
   Cabeçalho, menus, mensagens e rodapé ficam aqui uma vez só; cada tela
   entra no lugar do @RenderBody(). Quem diz que este é o layout padrão
   é o arquivo _ViewStart.cshtml. *@
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    @* viewport: faz o site se ajustar à largura do celular em vez de abrir "encolhido" *@
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] | Horizonte Viagens</title>
    <link rel="icon" href="~/assets/favicon.svg">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    @* asp-append-version acrescenta um código ao endereço do CSS: quando o arquivo
       muda, o navegador baixa a versão nova em vez de usar a guardada. *@
    <link rel="stylesheet" href="~/css/horizonte.css" asp-append-version="true">
</head>
<body>
    @* Atalho de acessibilidade: quem navega pelo teclado pula direto para o conteúdo. *@
    <a class="visually-hidden-focusable" href="#conteudo">Pular para o conteúdo</a>

    <header class="site-header">
        <a class="marca" href="/">☀ <span>horizonte<small>VIAGENS</small></span></a>

        @* Botão do menu (☰). Só aparece em telas estreitas (CSS, até 900px);
           o horizonte.js abre e fecha o menu e atualiza o aria-expanded,
           que avisa o leitor de tela se o menu está aberto. *@
        <button class="menu-toggle" type="button" aria-controls="menu-principal" aria-expanded="false" aria-label="Abrir menu">☰</button>

        <nav id="menu-principal" aria-label="Navegação principal">
            <a href="/Combos">Pacotes</a>
            <a href="/#eventos">Eventos</a>
            <a href="/#como-funciona">Como funciona</a>
        </nav>

        <div class="account-nav">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/Viagens">Minhas viagens</a>
                @* Sair é um POST com token anti-falsificação: um link de outro site
                   não consegue deslogar a pessoa sem ela clicar aqui. *@
                <form action="/Conta/Sair" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-dark">Sair</button>
                </form>
            }
            else
            {
                <a class="btn btn-dark" href="/Conta/Login">Entrar</a>
            }
        </div>
    </header>

    @* Segunda barra, só para quem está logado. Os links mudam conforme o papel
       guardado no cookie: o administrador gerencia, o cliente vê as coisas dele. *@
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="portal-nav" aria-label="Área da conta">
            <span>Olá, @User.Identity.Name</span>
            <a href="/Viagens">Reservas</a>
            @if (User.IsInRole("Administrador"))
            {
                <a href="/Combos/Gerenciar">Gerenciar combos</a>
                <a href="/Clientes">Clientes</a>
            }
            else
            {
                <a href="/Viagens/Carteira">Carteira</a>
                <a href="/Viagens/Favoritos">Favoritos</a>
                <a href="/Conta/Perfil">Meu perfil</a>
            }
        </nav>
    }

    <main id="conteudo">
        @* TempData guarda uma mensagem por UMA página: o controller grava antes do
           redirecionamento e ela aparece aqui uma vez só ("Combo cadastrado.") *@
        @if (TempData["Mensagem"] is string mensagem)
        {
            <div class="container alert alert-success mt-3" role="status">@mensagem</div>
        }
        @if (TempData["Erro"] is string erro)
        {
            <div class="container alert alert-danger mt-3" role="alert">@erro</div>
        }

        @RenderBody()
    </main>

    <footer class="site-footer">
        <div>
            <a class="marca" href="/">☀ horizonte</a>
            <p>Passagem, hospedagem e eventos.<br>Uma viagem completa, em um só lugar.</p>
        </div>
        <div>
            <a href="/Combos">Encontre seu destino</a>
            <a href="/Conta/Login?admin=true">Administração</a>
            <a href="/Home/Privacy">Privacidade</a>
        </div>
        <small>© @DateTime.Now.Year Horizonte Viagens</small>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/horizonte.js" asp-append-version="true"></script>
    @* Cada tela pode acrescentar scripts próprios numa seção "Scripts"
       (os formulários usam para ligar a validação no navegador). *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
