@model HorizonteViagens.Web.Models.ReservaViewModel
@* DETALHE DE UMA RESERVA. Os botões que aparecem dependem de quem está
   olhando (cliente ou administrador) e da situação da reserva. Essas
   respostas (Pendente, PodeCancelar...) já chegam prontas no ViewModel. *@
@{
    ViewData["Title"] = "Detalhes da reserva";
}

<section class="container section narrow">
    <a href="/Viagens">← Reservas</a>
    <h1>@Model.NomePacote</h1>
    <p>@Model.Codigo · <strong>@Model.Status</strong></p>
    <p>@Model.Viajantes adulto(s) · @Model.Quartos quarto(s) · @Model.Noites noites · @Model.Valor.ToString("C")</p>

    @* Área do cliente: pagar, cancelar e conferir o status do pagamento. *@
    @if (User.IsInRole("Cliente"))
    {
        if (Model.Pendente)
        {
            <div class="alert alert-info">
                Pagamento de teste: nenhuma cobrança real será realizada. A reserva fica pendente
                até a confirmação do serviço. Prazo: @Model.ExpiraEmLocal.ToString("dd/MM HH:mm").
            </div>

            <form method="post" asp-action="Pagar" asp-route-id="@Model.Id">
                <button class="btn btn-gold">Abrir pagamento de teste</button>
            </form>

            @* Depois que o pagamento foi aberto, só a agência cancela. *@
            if (Model.PodeCancelar)
            {
                <form method="post" asp-action="Cancelar" asp-route-id="@Model.Id" class="mt-3">
                    <button class="btn btn-outline-danger">Cancelar reserva pendente</button>
                </form>
            }
        }

        <form method="post" asp-action="Verificar" asp-route-id="@Model.Id" class="my-3">
            <button class="btn btn-outline-dark">Atualizar status do pagamento</button>
        </form>
    }

    <h2>Documentos da viagem</h2>
    @if (Model.Documentos.Count == 0)
    {
        <p>Os documentos aparecerão após a confirmação e emissão pela agência.</p>
    }
    @foreach (var documento in Model.Documentos)
    {
        <partial name="_Documento" model="documento" />
    }

    @* Área do administrador: depois da confirmação, a agência anexa os
       documentos emitidos pelos fornecedores (passagem, hotel, ingresso). *@
    @if (User.IsInRole("Administrador") && Model.Confirmada)
    {
        <h2>Adicionar documento emitido</h2>
        <form method="post" asp-action="Emitir" asp-route-id="@Model.Id">
            <label>Tipo <input name="Tipo" required maxlength="40" class="form-control" placeholder="Passagem, hospedagem ou evento"></label>
            <label>Título <input name="Titulo" required maxlength="140" class="form-control"></label>
            <label>URL HTTPS do fornecedor <input name="Url" type="url" required maxlength="1000" class="form-control"></label>
            <label>Código/localizador <input name="Codigo" required maxlength="100" class="form-control"></label>
            <button class="btn btn-gold mt-3">Adicionar à carteira</button>
        </form>
    }
</section>
