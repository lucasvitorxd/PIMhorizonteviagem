@model List<HorizonteViagens.Web.Models.DocumentoViewModel>
@* CARTEIRA DE VIAGEM: todos os documentos das reservas confirmadas do cliente,
   num lugar só. Cada documento é desenhado pela partial _Documento. *@
@{
    ViewData["Title"] = "Carteira de viagem";
}

<section class="container section">
    <span class="eyebrow">TUDO JUNTO PARA EMBARCAR</span>
    <h1>Minha carteira</h1>
    <p>Passagens, hospedagens e ingressos das suas reservas confirmadas.</p>

    <div class="reservation-grid">
        @foreach (var documento in Model)
        {
            <partial name="_Documento" model="documento" />
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-panel">Você ainda não possui documentos emitidos.</div>
    }
</section>
