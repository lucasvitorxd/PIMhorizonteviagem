<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\HorizonteViagens.Negocio\HorizonteViagens.Negocio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.22">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Roda no .NET 9; se a máquina só tiver o .NET 10, usa o 10 sem precisar mudar nada. -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Pasta do User Secrets do site (token de pagamento de teste, se usado). -->
    <UserSecretsId>horizonteviagens-web-e1623ef5-55d0-4df5-bb0f-a0b9b8d6494f</UserSecretsId>
  </PropertyGroup>

</Project>
